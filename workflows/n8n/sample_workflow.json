{
  "name": "Citizen Complaint to GRS",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "citizen-complaint",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.grs.gov.bd/v1/complaints",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer ={{$node[\"Webhook\"].json[\"body\"][\"token\"]}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "description",
              "value": "={{$node[\"Webhook\"].json[\"body\"][\"complaint_text\"]}}"
            }
          ]
        },
        "options": {}
      },
      "name": "GRS API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "GRS API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
